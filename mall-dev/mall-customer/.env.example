# DeepSeek Flash（使用 OpenAI 兼容接口，变量名保持 OPENAI_*）
# 在本地 .env 的下一项填写 DeepSeek API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# 实际商城接入使用 java；离线验证基础图时可显式改为 foundation
AGENT_RUNTIME_MODE=java
# Java 保存完整消息，并校验模型提炼的偏好、画像和会话摘要
CONVERSATION_MEMORY_ENABLED=true
AGENT_SERVICE_TOKEN=
# Java/Python 两端使用相同的服务凭证；运行令牌由 Java 为每个运行签发
MALL_BACKEND_URL=http://localhost:8800
MODEL_TIMEOUT_SECONDS=60
AGENT_ACTIVE_TIMEOUT_SECONDS=180

# 执行检查点使用独立 PostgreSQL 库，不读取商城业务表；数据库需提前创建
CHECKPOINT_BACKEND=postgres
# 示例：postgresql://postgres:你的密码@localhost:5432/mall_customer?connect_timeout=10
# 启动时自动创建/升级检查点表，不为等待人工的现场设置 TTL
CHECKPOINT_POSTGRES_DSN=
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5
# 等待连接池启动或获取连接的最长时间（秒）
CHECKPOINT_POOL_TIMEOUT_SECONDS=10

# RAG：父块存 PostgreSQL 独立 rag_* 表，子块存 Milvus 2.6+ 服务（不使用 Lite）
# 配齐服务后设 true；不启用时不影响基础 Agent
RAG_ENABLED=false
RAG_POSTGRES_DSN=
RAG_SOURCE_ROOT=./data/knowledge
RAG_KB_ID=mall_public
MINERU_API_TOKEN=
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
RAG_COLLECTION=mall_knowledge_children_v1
RAG_CHILD_SIZE=500
RAG_CHILD_OVERLAP=80
RAG_RECALL_K=30
RAG_MIN_RERANK_SCORE=0.2
DASHSCOPE_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_RERANK_MODEL=qwen3-rerank
# 按百炼工作空间/地域填写端点；支持既有 DashScope 标准 HTTP 协议
RAG_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# Server
HOST=0.0.0.0
PORT=8000
